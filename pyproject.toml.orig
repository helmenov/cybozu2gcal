[project]
name = "cybozu2gcal"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "icalendar>=7.3.0",
    "playwright>=1.62.0",
    "python-dotenv>=1.2.3",
]

[project.scripts]
cybozu2gcal = "cybozu2gcal:main"

[tool.uv]
managed = true

[build-system]
requires = ["uv_build>=0.11.21,<0.14"]
build-backend = "uv_build"


